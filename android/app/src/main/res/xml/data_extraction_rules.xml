<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing of Reflux leaves the device by backup or by transfer to a new device (docs/RELEASE.md, "Android release
    build"): the library holds the user's sources, sealed with a keystore key that never leaves this device, and
    their titles and paths. android:allowBackup="false" stops cloud backup; on Android 12 and later only these rules
    also stop device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
