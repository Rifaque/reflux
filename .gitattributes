# Shell scripts run on Linux and in containers even when the checkout is on Windows.
*.sh text eol=lf
gradlew text eol=lf
tools/ci/linux-packages.txt text eol=lf
tools/ci/Dockerfile text eol=lf
*.bat text eol=crlf
# License texts are shown in the app as they are; the same bytes on every checkout.
legal/** text eol=lf

# The Windows libmpv build runs in a Linux container.
tools/libmpv/** text eol=lf
