-- Reflux-owned library state. User media files are never modified; everything here can be rebuilt by
-- rescanning except user state (watch state, favorites, overrides, preferences).
-- SQL stays within SQLite 3.18 so platform SQLite on older Android devices works.

CREATE TABLE source (
    id TEXT NOT NULL PRIMARY KEY,
    type TEXT NOT NULL,
    display_name TEXT NOT NULL,
    locality TEXT NOT NULL,
    -- Adapter-specific connection data (e.g. a folder path). Interpreted only by the adapter.
    config TEXT NOT NULL,
    availability TEXT NOT NULL,
    added_at INTEGER NOT NULL,
    last_scan_at INTEGER,
    last_available_at INTEGER,
    -- Whether the source takes part in the unified library (docs/NAVIGATION.md). Never changed by availability.
    included INTEGER NOT NULL DEFAULT 1,
    -- The source answered but no longer accepts Reflux's sign-in: signing in again is the way back.
    sign_in_required INTEGER NOT NULL DEFAULT 0
);

-- The libraries a source is made of (a server's), as last read, so they can be shown while it is away.
CREATE TABLE source_section (
    source_id TEXT NOT NULL,
    section_id TEXT NOT NULL,
    name TEXT NOT NULL,
    kind TEXT NOT NULL,
    position INTEGER NOT NULL,
    PRIMARY KEY (source_id, section_id)
);

-- Libraries the viewer left out of the unified library. Kept while the source is, so a library that comes
-- back, or a source switched on again, has the choice that was made.
CREATE TABLE excluded_section (
    source_id TEXT NOT NULL,
    section_id TEXT NOT NULL,
    PRIMARY KEY (source_id, section_id)
);

CREATE TABLE item (
    id TEXT NOT NULL PRIMARY KEY,
    kind TEXT NOT NULL,
    title TEXT NOT NULL,
    title_key TEXT NOT NULL,
    sort_key TEXT NOT NULL,
    year INTEGER,
    show_id TEXT,
    season_id TEXT,
    season_number INTEGER,
    episode_number INTEGER,
    episode_number_end INTEGER,
    absolute_number INTEGER,
    air_date TEXT,
    -- Provider IDs found in file names, e.g. "tmdb=157336" (newline separated).
    external_hints TEXT NOT NULL DEFAULT '',
    -- For movies and shows: the identity key the work was created from (after aliasing).
    identity_key TEXT,
    added_at INTEGER NOT NULL
);

CREATE INDEX item_kind ON item(kind);
CREATE INDEX item_show ON item(show_id);
CREATE INDEX item_title_key ON item(title_key);

CREATE TABLE version (
    id TEXT NOT NULL PRIMARY KEY,
    item_id TEXT NOT NULL,
    source_id TEXT NOT NULL,
    path TEXT NOT NULL,
    size_bytes INTEGER NOT NULL,
    modified_at INTEGER NOT NULL,
    stream_origin TEXT NOT NULL,
    container TEXT NOT NULL,
    video_codec TEXT,
    width INTEGER,
    height INTEGER,
    bit_depth INTEGER,
    dynamic_range TEXT,
    dolby_vision_profile INTEGER,
    frame_rate REAL,
    duration_ms INTEGER,
    bitrate_bps INTEGER,
    edition TEXT,
    part INTEGER,
    confidence REAL NOT NULL,
    signals TEXT NOT NULL,
    -- Last probe attempt; reset when the file changes. Avoids re-probing unreadable files on every pass.
    probe_attempted_at INTEGER,
    -- For catalog sources: the source's own description of the work, so corrections re-identify offline.
    source_identity TEXT,
    first_seen_at INTEGER NOT NULL,
    last_seen_at INTEGER NOT NULL,
    -- Added by a migration: last, so that a migrated table and a new one have the same column order.
    video_profile TEXT,
    video_level INTEGER,
    -- The library of its source the version is in, for sources made of libraries.
    section TEXT,
    -- The source and library the version belongs to for browsing and inclusion: its own, or for a copy kept on
    -- the device, those of the version it was copied from. Recomputed by recomputeVersionLibraries.
    library_source_id TEXT NOT NULL DEFAULT '',
    library_section TEXT,
    -- Whether it takes part in the unified library, from its library's source and section (recomputeInclusion).
    included INTEGER NOT NULL DEFAULT 1,
    UNIQUE (source_id, path)
);

CREATE INDEX version_item ON version(item_id);

CREATE INDEX version_library ON version(library_source_id, library_section);

-- Audio and embedded subtitle tracks of a version.
CREATE TABLE track (
    version_id TEXT NOT NULL,
    position INTEGER NOT NULL,
    type TEXT NOT NULL,
    codec TEXT NOT NULL,
    channels INTEGER,
    language TEXT,
    atmos INTEGER NOT NULL DEFAULT 0,
    forced INTEGER NOT NULL DEFAULT 0,
    is_default INTEGER NOT NULL DEFAULT 0,
    sample_rate INTEGER,
    hearing_impaired INTEGER NOT NULL DEFAULT 0,
    source_index INTEGER,
    PRIMARY KEY (version_id, type, position)
);

CREATE TABLE external_subtitle (
    version_id TEXT NOT NULL,
    source_id TEXT NOT NULL,
    path TEXT NOT NULL,
    format TEXT NOT NULL,
    language TEXT,
    forced INTEGER NOT NULL,
    hearing_impaired INTEGER NOT NULL,
    PRIMARY KEY (version_id, path)
);

CREATE TABLE artwork (
    item_id TEXT NOT NULL,
    kind TEXT NOT NULL,
    origin TEXT NOT NULL,
    -- For images inside a source; null for remote artwork.
    source_id TEXT,
    locator TEXT NOT NULL,
    PRIMARY KEY (item_id, kind, origin)
);

CREATE INDEX artwork_source ON artwork(source_id);

-- The canonical watch state: one row per work, whichever copy played.
CREATE TABLE watch_state (
    item_id TEXT NOT NULL PRIMARY KEY,
    position_ms INTEGER NOT NULL,
    duration_ms INTEGER,
    completed INTEGER NOT NULL,
    play_count INTEGER NOT NULL,
    last_played_at INTEGER,
    -- When the user last changed this state, wherever that happened.
    updated_at INTEGER,
    -- The copy the position was measured on (it may be gone) and its cut: the position's timeline.
    version_id TEXT,
    cut TEXT
);

-- What a source said about one of its items when it was last compared with the canonical state.
CREATE TABLE watch_sync (
    source_id TEXT NOT NULL,
    path TEXT NOT NULL,
    played INTEGER NOT NULL,
    position_ms INTEGER NOT NULL,
    last_played_at INTEGER,
    -- When the source and Reflux last had nothing left to settle for this item.
    reconciled_at INTEGER NOT NULL,
    PRIMARY KEY (source_id, path)
);

CREATE TABLE favorite (
    item_id TEXT NOT NULL PRIMARY KEY,
    added_at INTEGER NOT NULL
);

-- "Identify this movie/show": a correction keyed by file location.
CREATE TABLE identity_override (
    source_id TEXT NOT NULL,
    path TEXT NOT NULL,
    kind TEXT NOT NULL,
    title TEXT NOT NULL,
    year INTEGER,
    season INTEGER,
    episode INTEGER,
    created_at INTEGER NOT NULL,
    PRIMARY KEY (source_id, path)
);

-- Descriptive metadata from a provider. Display titles here override parsed titles.
CREATE TABLE metadata (
    item_id TEXT NOT NULL PRIMARY KEY,
    provider_ref TEXT NOT NULL,
    title TEXT,
    sort_key TEXT,
    original_title TEXT,
    overview TEXT,
    tagline TEXT,
    genres TEXT NOT NULL,
    runtime_minutes INTEGER,
    release_date TEXT,
    rating REAL,
    content_rating TEXT,
    external_ids TEXT NOT NULL,
    -- Franchise of a movie (see provider_collection).
    collection_id TEXT,
    -- For seasons: how many episodes the provider lists as aired.
    episode_count INTEGER,
    match_score REAL NOT NULL,
    fetched_at INTEGER NOT NULL
);

CREATE TABLE provider_collection (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    poster_url TEXT,
    backdrop_url TEXT
);

-- Collections the user made: a fixed list of works, or a saved smart search.
CREATE TABLE user_collection (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    smart_query TEXT,
    created_at INTEGER NOT NULL
);

CREATE TABLE user_collection_item (
    collection_id TEXT NOT NULL,
    item_id TEXT NOT NULL,
    added_at INTEGER NOT NULL,
    PRIMARY KEY (collection_id, item_id)
);

CREATE TABLE credit (
    item_id TEXT NOT NULL,
    position INTEGER NOT NULL,
    name TEXT NOT NULL,
    role TEXT NOT NULL,
    character TEXT,
    profile_url TEXT,
    PRIMARY KEY (item_id, position)
);

-- Outcome of the last automatic lookup, so unmatched works are not looked up on every refresh.
CREATE TABLE metadata_attempt (
    item_id TEXT NOT NULL PRIMARY KEY,
    attempted_at INTEGER NOT NULL,
    outcome TEXT NOT NULL
);

-- A provider entry the user chose in the Identify flow.
CREATE TABLE metadata_pin (
    item_id TEXT NOT NULL PRIMARY KEY,
    provider_ref TEXT NOT NULL
);

-- Two identity keys for the same work (e.g. different names on two sources sharing a provider ID).
CREATE TABLE identity_alias (
    alias_key TEXT NOT NULL PRIMARY KEY,
    canonical_key TEXT NOT NULL,
    created_at INTEGER NOT NULL
);

-- A user's pinned version for a work.
CREATE TABLE version_preference (
    item_id TEXT NOT NULL PRIMARY KEY,
    version_id TEXT NOT NULL
);

-- Sources ---------------------------------------------------------------------------------------

insertSource:
INSERT OR IGNORE INTO source(id, type, display_name, locality, config, availability, added_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

renameSource:
UPDATE source SET display_name = ? WHERE id = ?;

updateSourceConnection:
UPDATE source SET display_name = :displayName, locality = :locality, config = :config WHERE id = :id;

-- How many movies and shows a source holds, for saying what is on it.
sourceContents:
SELECT
  (SELECT COUNT(DISTINCT version.item_id) FROM version JOIN item ON item.id = version.item_id
     WHERE version.source_id = :id AND item.kind = 'MOVIE') AS movies,
  (SELECT COUNT(DISTINCT item.show_id) FROM version JOIN item ON item.id = version.item_id
     WHERE version.source_id = :id AND item.kind = 'EPISODE') AS shows;

sourceById:
SELECT * FROM source WHERE id = ?;

allSources:
SELECT * FROM source ORDER BY added_at, id;

markSourceScanned:
UPDATE source SET availability = 'AVAILABLE', sign_in_required = 0, last_scan_at = :now, last_available_at = :now WHERE id = :id;

setSourceSignInRequired:
UPDATE source SET availability = 'UNAVAILABLE', sign_in_required = 1 WHERE id = :id;

setSourceIncluded:
UPDATE source SET included = :included WHERE id = :id;

-- Libraries ---------------------------------------------------------------------------------------

sourceSectionsOf:
SELECT * FROM source_section WHERE source_id = ? ORDER BY position, section_id;

deleteSourceSectionsOf:
DELETE FROM source_section WHERE source_id = ?;

insertSourceSection:
INSERT OR REPLACE INTO source_section(source_id, section_id, name, kind, position) VALUES (?, ?, ?, ?, ?);

excludedSectionsOf:
SELECT section_id FROM excluded_section WHERE source_id = ?;

excludeSection:
INSERT OR IGNORE INTO excluded_section(source_id, section_id) VALUES (?, ?);

includeSection:
DELETE FROM excluded_section WHERE source_id = ? AND section_id = ?;

deleteExcludedSectionsOf:
DELETE FROM excluded_section WHERE source_id = ?;

-- How many movies and shows one library of a source holds.
sectionContents:
SELECT
  (SELECT COUNT(DISTINCT version.item_id) FROM version JOIN item ON item.id = version.item_id
     WHERE version.library_source_id = :id AND version.library_section = :section AND item.kind = 'MOVIE') AS movies,
  (SELECT COUNT(DISTINCT item.show_id) FROM version JOIN item ON item.id = version.item_id
     WHERE version.library_source_id = :id AND version.library_section = :section AND item.kind = 'EPISODE') AS shows;

-- Which source and library each version belongs to: a copy kept on the device belongs where the version it was
-- copied from does (or did, once that version is gone).
recomputeVersionLibraries:
UPDATE version SET
  library_source_id = COALESCE(
    (SELECT download.origin_source_id FROM download JOIN source ON source.id = version.source_id
     WHERE source.type = 'downloads' AND download.path = version.path),
    version.source_id),
  library_section = CASE
    WHEN EXISTS (SELECT 1 FROM download JOIN source ON source.id = version.source_id
                 WHERE source.type = 'downloads' AND download.path = version.path)
    THEN COALESCE(
      (SELECT origin.section FROM download JOIN version origin ON origin.id = download.origin_version_id
       WHERE download.path = version.path),
      version.library_section)
    ELSE version.section END;

-- Whether each version takes part in the unified library: its library's source is included, and its library
-- is not excluded. A copy whose origin source is gone stays included.
recomputeInclusion:
UPDATE version SET included = CASE
  WHEN EXISTS (SELECT 1 FROM source WHERE source.id = version.library_source_id AND source.included = 0) THEN 0
  WHEN EXISTS (SELECT 1 FROM excluded_section
               WHERE excluded_section.source_id = version.library_source_id AND excluded_section.section_id = version.library_section) THEN 0
  ELSE 1 END;

setSourceAvailability:
UPDATE source SET availability = :availability,
    last_available_at = CASE WHEN :availability = 'AVAILABLE' THEN :now ELSE last_available_at END
WHERE id = :id;

deleteSource:
DELETE FROM source WHERE id = ?;

-- Items -----------------------------------------------------------------------------------------

insertItemIfAbsent:
INSERT OR IGNORE INTO item(
    id, kind, title, title_key, sort_key, year, show_id, season_id, season_number, episode_number,
    episode_number_end, absolute_number, air_date, external_hints, identity_key, added_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateItem:
UPDATE item SET title = :title, title_key = :titleKey, sort_key = :sortKey, year = :year,
    episode_number_end = :episodeNumberEnd, external_hints = :externalHints, identity_key = :identityKey
WHERE id = :id;

itemById:
SELECT * FROM item WHERE id = ?;

itemsByIds:
SELECT * FROM item WHERE id IN ?;

-- Years known for titles from *other* sources; this source's own items are re-derived during its scan.
yearHintsExcludingSource:
SELECT kind, title_key, year FROM item
WHERE year IS NOT NULL AND kind = 'MOVIE'
  AND EXISTS (SELECT 1 FROM version WHERE version.item_id = item.id AND version.source_id != :sourceId)
UNION
SELECT kind, title_key, year FROM item
WHERE year IS NOT NULL AND kind = 'SHOW' AND EXISTS (
    SELECT 1 FROM item episode JOIN version ON version.item_id = episode.id
    WHERE episode.show_id = item.id AND version.source_id != :sourceId
);

-- The queries below take a scope: with :source null, the unified library (included versions); otherwise one
-- source, or one :section of it (docs/NAVIGATION.md, section 4).
presentMovies:
SELECT item.* FROM item LEFT JOIN metadata ON metadata.item_id = item.id
WHERE item.kind = 'MOVIE' AND EXISTS (SELECT 1 FROM version WHERE version.item_id = item.id AND ((:source IS NULL AND version.included = 1) OR (version.library_source_id = :source AND (:section IS NULL OR version.library_section = :section))))
ORDER BY COALESCE(metadata.sort_key, item.sort_key), item.year;

presentShows:
SELECT item.* FROM item LEFT JOIN metadata ON metadata.item_id = item.id
WHERE item.kind = 'SHOW' AND EXISTS (
    SELECT 1 FROM item episode JOIN version ON version.item_id = episode.id WHERE episode.show_id = item.id AND ((:source IS NULL AND version.included = 1) OR (version.library_source_id = :source AND (:section IS NULL OR version.library_section = :section)))
)
ORDER BY COALESCE(metadata.sort_key, item.sort_key), item.year;

presentSeasonsOfShow:
SELECT * FROM item
WHERE kind = 'SEASON' AND show_id = :showId AND EXISTS (
    SELECT 1 FROM item episode JOIN version ON version.item_id = episode.id WHERE episode.season_id = item.id AND ((:source IS NULL AND version.included = 1) OR (version.library_source_id = :source AND (:section IS NULL OR version.library_section = :section)))
)
ORDER BY season_number;

episodesOfShow:
SELECT * FROM item WHERE kind = 'EPISODE' AND show_id = ?;

presentEpisodesOfSeason:
SELECT * FROM item
WHERE kind = 'EPISODE' AND season_id = :seasonId AND EXISTS (SELECT 1 FROM version WHERE version.item_id = item.id AND ((:source IS NULL AND version.included = 1) OR (version.library_source_id = :source AND (:section IS NULL OR version.library_section = :section))))
ORDER BY episode_number, absolute_number, air_date;

presentPlayables:
SELECT * FROM item
WHERE kind IN ('MOVIE', 'EPISODE') AND EXISTS (SELECT 1 FROM version WHERE version.item_id = item.id AND ((:source IS NULL AND version.included = 1) OR (version.library_source_id = :source AND (:section IS NULL OR version.library_section = :section))));

-- Whatever there is to play, in any scope: what library changes are watched by.
anyPlayables:
SELECT item.id FROM item
WHERE kind IN ('MOVIE', 'EPISODE') AND EXISTS (SELECT 1 FROM version WHERE version.item_id = item.id);

deleteOrphanPlayables:
DELETE FROM item
WHERE kind IN ('MOVIE', 'EPISODE')
  AND NOT EXISTS (SELECT 1 FROM version WHERE version.item_id = item.id)
  AND NOT EXISTS (SELECT 1 FROM watch_state WHERE watch_state.item_id = item.id)
  AND NOT EXISTS (SELECT 1 FROM favorite WHERE favorite.item_id = item.id);

deleteEmptySeasons:
DELETE FROM item
WHERE kind = 'SEASON'
  AND NOT EXISTS (SELECT 1 FROM item episode WHERE episode.season_id = item.id)
  AND NOT EXISTS (SELECT 1 FROM favorite WHERE favorite.item_id = item.id);

deleteEmptyShows:
DELETE FROM item
WHERE kind = 'SHOW'
  AND NOT EXISTS (SELECT 1 FROM item child WHERE child.show_id = item.id)
  AND NOT EXISTS (SELECT 1 FROM favorite WHERE favorite.item_id = item.id);

-- Versions --------------------------------------------------------------------------------------

insertVersionIfAbsent:
INSERT OR IGNORE INTO version(
    id, item_id, source_id, path, size_bytes, modified_at, stream_origin, container, video_codec, width, height,
    bit_depth, dynamic_range, dolby_vision_profile, frame_rate, duration_ms, bitrate_bps, edition, part,
    confidence, signals, source_identity, first_seen_at, last_seen_at, video_profile, video_level, section, library_source_id, library_section
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateVersion:
UPDATE version SET item_id = :itemId, size_bytes = :sizeBytes, modified_at = :modifiedAt,
    stream_origin = :streamOrigin, container = :container, video_codec = :videoCodec, width = :width,
    height = :height, bit_depth = :bitDepth, dynamic_range = :dynamicRange,
    dolby_vision_profile = :dolbyVisionProfile, frame_rate = :frameRate, duration_ms = :durationMs,
    bitrate_bps = :bitrateBps, edition = :edition, part = :part, confidence = :confidence, signals = :signals,
    probe_attempted_at = NULL, source_identity = :sourceIdentity, last_seen_at = :lastSeenAt,
    video_profile = :videoProfile, video_level = :videoLevel, section = :section
WHERE id = :id;

updateVersionStream:
UPDATE version SET stream_origin = :streamOrigin, container = :container, video_codec = :videoCodec, width = :width,
    height = :height, bit_depth = :bitDepth, dynamic_range = :dynamicRange,
    dolby_vision_profile = :dolbyVisionProfile, frame_rate = :frameRate, duration_ms = :durationMs,
    bitrate_bps = :bitrateBps, probe_attempted_at = :probedAt, video_profile = :videoProfile, video_level = :videoLevel
WHERE id = :id;

markProbeAttempted:
UPDATE version SET probe_attempted_at = ? WHERE id = ?;

versionsAwaitingProbe:
SELECT version.id FROM version JOIN source ON source.id = version.source_id
WHERE version.stream_origin = 'FILENAME_HINTS' AND version.probe_attempted_at IS NULL
  AND source.availability = 'AVAILABLE'
ORDER BY version.first_seen_at DESC, version.id
LIMIT ?;

versionsOfSource:
SELECT id, item_id, path, size_bytes, modified_at, stream_origin, source_identity FROM version WHERE source_id = ?;

updateVersionIdentity:
UPDATE version SET item_id = :itemId, edition = :edition, part = :part, confidence = :confidence,
    signals = :signals, last_seen_at = :lastSeenAt, section = :section
WHERE id = :id;

externalSubtitlePathsOfSource:
SELECT path FROM external_subtitle WHERE source_id = ?;

artworkPathsOfSource:
SELECT locator FROM artwork WHERE source_id = ?;

versionsOfItem:
SELECT version.*, source.availability, source.locality
FROM version JOIN source ON source.id = version.source_id
WHERE version.item_id = :itemId AND ((:source IS NULL AND version.included = 1) OR (version.library_source_id = :source AND (:section IS NULL OR version.library_section = :section)))
ORDER BY version.id;

-- Every version of every episode of a show, by episode: how many there are to choose between.
versionIdsOfShow:
SELECT version.id, version.item_id
FROM version JOIN item ON item.id = version.item_id
WHERE item.show_id = ?;

-- The episodes of a show with a version somewhere other than on the device: what there is to keep of it.
episodesOffDeviceOfShow:
SELECT DISTINCT item.id FROM version JOIN item ON item.id = version.item_id JOIN source ON source.id = version.source_id
WHERE item.show_id = ? AND source.locality != 'DEVICE';

versionById:
SELECT version.*, source.availability, source.locality
FROM version JOIN source ON source.id = version.source_id
WHERE version.id = ?;

itemAvailability:
SELECT version.item_id, source.availability
FROM version JOIN source ON source.id = version.source_id
WHERE ((:source IS NULL AND version.included = 1) OR (version.library_source_id = :source AND (:section IS NULL OR version.library_section = :section)));

lowConfidenceVersions:
SELECT * FROM version WHERE confidence < ? ORDER BY source_id, path;

deleteVersion:
DELETE FROM version WHERE id = ?;

itemHasVersions:
SELECT EXISTS (SELECT 1 FROM version WHERE item_id = ? AND included = 1);

-- Tracks and subtitles --------------------------------------------------------------------------

insertTrack:
INSERT OR REPLACE INTO track(version_id, position, type, codec, channels, language, atmos, forced, is_default, sample_rate, hearing_impaired, source_index)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

tracksOfVersion:
SELECT * FROM track WHERE version_id = ? ORDER BY type, position;

deleteTracksOfVersion:
DELETE FROM track WHERE version_id = ?;

insertExternalSubtitle:
INSERT OR REPLACE INTO external_subtitle(version_id, source_id, path, format, language, forced, hearing_impaired)
VALUES (?, ?, ?, ?, ?, ?, ?);

externalSubtitlesOfVersion:
SELECT * FROM external_subtitle WHERE version_id = ? ORDER BY path;

deleteExternalSubtitlesOfSource:
DELETE FROM external_subtitle WHERE source_id = ?;

deleteExternalSubtitlesOfVersion:
DELETE FROM external_subtitle WHERE version_id = ?;

-- Artwork ---------------------------------------------------------------------------------------

upsertArtwork:
INSERT OR REPLACE INTO artwork(item_id, kind, origin, source_id, locator) VALUES (?, ?, ?, ?, ?);

artworkOfItem:
SELECT * FROM artwork WHERE item_id = ?;

artworkOfItems:
SELECT * FROM artwork WHERE item_id IN ?;

deleteArtworkOfSource:
DELETE FROM artwork WHERE source_id = ? AND origin = ?;

artworkOfSource:
SELECT * FROM artwork WHERE source_id = ? AND origin = ?;

deleteOrphanArtwork:
DELETE FROM artwork WHERE item_id NOT IN (SELECT id FROM item);

deleteArtworkOfItemByOrigin:
DELETE FROM artwork WHERE item_id = ? AND origin = ?;

-- Metadata ----------------------------------------------------------------------------------------

upsertMetadata:
INSERT OR REPLACE INTO metadata(
    item_id, provider_ref, title, sort_key, original_title, overview, tagline, genres, runtime_minutes,
    release_date, rating, content_rating, external_ids, collection_id, episode_count, match_score, fetched_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

upsertProviderCollection:
INSERT OR REPLACE INTO provider_collection(id, name, poster_url, backdrop_url) VALUES (?, ?, ?, ?);

metadataOf:
SELECT * FROM metadata WHERE item_id = ?;

metadataOfItems:
SELECT * FROM metadata WHERE item_id IN ?;

deleteCredits:
DELETE FROM credit WHERE item_id = ?;

insertCredit:
INSERT OR REPLACE INTO credit(item_id, position, name, role, character, profile_url) VALUES (?, ?, ?, ?, ?, ?);

creditsOf:
SELECT * FROM credit WHERE item_id = ? ORDER BY position;

-- Movies and shows to look up: no metadata yet, and no recent unsuccessful attempt.
worksNeedingMetadata:
SELECT item.* FROM item
WHERE item.kind IN ('MOVIE', 'SHOW')
  AND NOT EXISTS (SELECT 1 FROM metadata WHERE metadata.item_id = item.id)
  AND NOT EXISTS (
    SELECT 1 FROM metadata_attempt WHERE metadata_attempt.item_id = item.id AND metadata_attempt.attempted_at > :retryBefore
  )
  AND (
    EXISTS (SELECT 1 FROM version WHERE version.item_id = item.id)
    OR EXISTS (SELECT 1 FROM item episode JOIN version ON version.item_id = episode.id WHERE episode.show_id = item.id)
  )
ORDER BY item.added_at DESC, item.id
LIMIT :limit;

-- Shows with metadata whose present episodes still lack it (new episodes added later).
showsWithEpisodesNeedingMetadata:
SELECT DISTINCT show.id FROM item show
JOIN metadata show_meta ON show_meta.item_id = show.id
JOIN item episode ON episode.show_id = show.id AND episode.kind = 'EPISODE'
JOIN version ON version.item_id = episode.id
WHERE show.kind = 'SHOW'
  AND NOT EXISTS (SELECT 1 FROM metadata WHERE metadata.item_id = episode.id)
  AND NOT EXISTS (
    SELECT 1 FROM metadata_attempt WHERE metadata_attempt.item_id = episode.id AND metadata_attempt.attempted_at > :retryBefore
  )
LIMIT :limit;

recordMetadataAttempt:
INSERT OR REPLACE INTO metadata_attempt(item_id, attempted_at, outcome) VALUES (?, ?, ?);

clearMetadataAttempt:
DELETE FROM metadata_attempt WHERE item_id = ?;

metadataAttemptOf:
SELECT * FROM metadata_attempt WHERE item_id = ?;

pinMetadata:
INSERT OR REPLACE INTO metadata_pin(item_id, provider_ref) VALUES (?, ?);

metadataPinOf:
SELECT provider_ref FROM metadata_pin WHERE item_id = ?;

unpinMetadata:
DELETE FROM metadata_pin WHERE item_id = ?;

deleteMetadataOf:
DELETE FROM metadata WHERE item_id = ?;

deleteOrphanMetadata:
DELETE FROM metadata WHERE item_id NOT IN (SELECT id FROM item);

deleteOrphanCredits:
DELETE FROM credit WHERE item_id NOT IN (SELECT id FROM item);

deleteOrphanAttempts:
DELETE FROM metadata_attempt WHERE item_id NOT IN (SELECT id FROM item);

presentSeasonsAndEpisodesOfShow:
SELECT * FROM item
WHERE show_id = ? AND (
    (kind = 'EPISODE' AND EXISTS (SELECT 1 FROM version WHERE version.item_id = item.id))
    OR (kind = 'SEASON' AND EXISTS (
        SELECT 1 FROM item episode JOIN version ON version.item_id = episode.id WHERE episode.season_id = item.id))
);

-- Watch state, favorites, overrides, preferences -------------------------------------------------

upsertWatchState:
INSERT OR REPLACE INTO watch_state(item_id, position_ms, duration_ms, completed, play_count, last_played_at, updated_at, version_id, cut)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteWatchState:
DELETE FROM watch_state WHERE item_id = ?;

watchSyncOf:
SELECT * FROM watch_sync WHERE source_id = ? AND path = ?;

upsertWatchSync:
INSERT OR REPLACE INTO watch_sync(source_id, path, played, position_ms, last_played_at, reconciled_at)
VALUES (?, ?, ?, ?, ?, ?);

markWatchSyncReconciled:
UPDATE watch_sync SET reconciled_at = :now WHERE source_id = :sourceId AND path = :path;

deleteWatchSyncOfSource:
DELETE FROM watch_sync WHERE source_id = ?;

watchStateOf:
SELECT * FROM watch_state WHERE item_id = ?;

allWatchStates:
SELECT * FROM watch_state;

watchStatesOfItems:
SELECT * FROM watch_state WHERE item_id IN ?;

recentlyPlayed:
SELECT * FROM watch_state WHERE last_played_at IS NOT NULL ORDER BY last_played_at DESC LIMIT ?;

-- Movies and shows by when they (or a show's newest episode) appeared.
recentlyAdded:
SELECT item.*, CASE WHEN item.kind = 'SHOW' THEN (
    SELECT MAX(episode.added_at) FROM item episode JOIN version ON version.item_id = episode.id
    WHERE episode.show_id = item.id AND version.included = 1
) ELSE item.added_at END AS latest_added_at
FROM item
WHERE (item.kind = 'MOVIE' AND EXISTS (SELECT 1 FROM version WHERE version.item_id = item.id AND version.included = 1))
   OR (item.kind = 'SHOW' AND EXISTS (
        SELECT 1 FROM item episode JOIN version ON version.item_id = episode.id WHERE episode.show_id = item.id AND version.included = 1))
ORDER BY latest_added_at DESC, item.sort_key
LIMIT ?;

insertFavorite:
INSERT OR IGNORE INTO favorite(item_id, added_at) VALUES (?, ?);

deleteFavorite:
DELETE FROM favorite WHERE item_id = ?;

allFavorites:
SELECT * FROM favorite ORDER BY added_at DESC;

upsertOverride:
INSERT OR REPLACE INTO identity_override(source_id, path, kind, title, year, season, episode, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

overridesOfSource:
SELECT * FROM identity_override WHERE source_id = ?;

deleteOverride:
DELETE FROM identity_override WHERE source_id = ? AND path = ?;

setPreferredVersion:
INSERT OR REPLACE INTO version_preference(item_id, version_id) VALUES (?, ?);

preferredVersion:
SELECT version_id FROM version_preference WHERE item_id = ?;

clearPreferredVersion:
DELETE FROM version_preference WHERE item_id = ?;

-- A pin names a version; when re-identification gives that version to another work (a show's episodes, when
-- the show is identified), the pin goes with it.
movePinsWithTheirVersions:
UPDATE OR REPLACE version_preference
SET item_id = (SELECT version.item_id FROM version WHERE version.id = version_preference.version_id)
WHERE EXISTS (SELECT 1 FROM version WHERE version.id = version_preference.version_id AND version.item_id != version_preference.item_id);

-- Smart search facts ------------------------------------------------------------------------------

versionFacts:
SELECT version.item_id, item.show_id, version.width, version.height, version.dynamic_range, version.duration_ms
FROM version JOIN item ON item.id = version.item_id;

metadataFacts:
SELECT item_id, genres, runtime_minutes, release_date FROM metadata;

creditNames:
SELECT item_id, name FROM credit;

-- Collections ---------------------------------------------------------------------------------------

-- Provider franchises with at least two present movies.
franchises:
SELECT provider_collection.*, COUNT(*) AS present
FROM provider_collection
JOIN metadata ON metadata.collection_id = provider_collection.id
JOIN item ON item.id = metadata.item_id
WHERE item.kind = 'MOVIE' AND EXISTS (SELECT 1 FROM version WHERE version.item_id = item.id AND version.included = 1)
GROUP BY provider_collection.id
HAVING COUNT(*) >= 2
ORDER BY provider_collection.name;

franchiseMovies:
SELECT item.* FROM item JOIN metadata ON metadata.item_id = item.id
WHERE metadata.collection_id = ? AND item.kind = 'MOVIE'
  AND EXISTS (SELECT 1 FROM version WHERE version.item_id = item.id AND version.included = 1)
ORDER BY metadata.release_date, item.year;

franchiseOf:
SELECT provider_collection.* FROM provider_collection JOIN metadata ON metadata.collection_id = provider_collection.id
WHERE metadata.item_id = ?;

insertUserCollection:
INSERT INTO user_collection(id, name, smart_query, created_at) VALUES (?, ?, ?, ?);

renameUserCollection:
UPDATE user_collection SET name = ? WHERE id = ?;

deleteUserCollection:
DELETE FROM user_collection WHERE id = ?;

deleteUserCollectionItems:
DELETE FROM user_collection_item WHERE collection_id = ?;

userCollections:
SELECT * FROM user_collection ORDER BY created_at, id;

userCollectionById:
SELECT * FROM user_collection WHERE id = ?;

addToUserCollection:
INSERT OR IGNORE INTO user_collection_item(collection_id, item_id, added_at) VALUES (?, ?, ?);

removeFromUserCollection:
DELETE FROM user_collection_item WHERE collection_id = ? AND item_id = ?;

userCollectionItemIds:
SELECT item_id FROM user_collection_item WHERE collection_id = ? ORDER BY added_at, item_id;

-- Diagnostics ---------------------------------------------------------------------------------------

worksWithoutMatch:
SELECT item.*, metadata_attempt.outcome FROM item JOIN metadata_attempt ON metadata_attempt.item_id = item.id
WHERE item.kind IN ('MOVIE', 'SHOW') AND metadata_attempt.outcome != 'MATCHED'
  AND NOT EXISTS (SELECT 1 FROM metadata WHERE metadata.item_id = item.id)
ORDER BY item.sort_key;

worksWithSeveralVersions:
SELECT item_id, COUNT(*) AS versions FROM version GROUP BY item_id HAVING COUNT(*) > 1;

seasonEpisodeCounts:
SELECT item.id, item.show_id, item.season_number, metadata.episode_count
FROM item JOIN metadata ON metadata.item_id = item.id
WHERE item.kind = 'SEASON' AND metadata.episode_count IS NOT NULL;

-- Unification -----------------------------------------------------------------------------------------

allAliases:
SELECT alias_key, canonical_key FROM identity_alias;

insertAlias:
INSERT OR REPLACE INTO identity_alias(alias_key, canonical_key, created_at) VALUES (?, ?, ?);

-- Present movies and shows with everything that can identify them at a provider.
unificationCandidates:
SELECT item.id, item.kind, item.identity_key, item.added_at, item.external_hints, metadata.provider_ref, metadata.external_ids
FROM item LEFT JOIN metadata ON metadata.item_id = item.id
WHERE item.identity_key IS NOT NULL AND (
    (item.kind = 'MOVIE' AND EXISTS (SELECT 1 FROM version WHERE version.item_id = item.id))
    OR (item.kind = 'SHOW' AND EXISTS (
        SELECT 1 FROM item episode JOIN version ON version.item_id = episode.id WHERE episode.show_id = item.id))
);

sourcesOfWork:
SELECT DISTINCT version.source_id FROM version JOIN item ON item.id = version.item_id
WHERE item.id = :id OR item.show_id = :id;

moveFavorite:
INSERT OR IGNORE INTO favorite(item_id, added_at) SELECT :toId, added_at FROM favorite WHERE item_id = :fromId;

moveCollectionMembership:
INSERT OR IGNORE INTO user_collection_item(collection_id, item_id, added_at)
SELECT collection_id, :toId, added_at FROM user_collection_item WHERE item_id = :fromId;

deleteCollectionMembershipOf:
DELETE FROM user_collection_item WHERE item_id = ?;

-- Downloads ---------------------------------------------------------------------------------------

-- A copy of one version, kept on the device. When complete it is registered as a version of the same
-- work in the downloads source; it is never a work of its own.
CREATE TABLE download (
    id TEXT NOT NULL PRIMARY KEY,
    -- The work the copy belongs to: its origin's while the origin is known, the last one known after.
    item_id TEXT NOT NULL,
    origin_version_id TEXT NOT NULL UNIQUE,
    origin_source_id TEXT NOT NULL,
    origin_path TEXT NOT NULL,
    -- Where the copy is, relative to where downloads are kept.
    path TEXT NOT NULL,
    state TEXT NOT NULL,
    failure TEXT,
    bytes_downloaded INTEGER NOT NULL,
    total_bytes INTEGER,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    completed_at INTEGER
);

-- A separate subtitle file kept with a download.
CREATE TABLE download_subtitle (
    download_id TEXT NOT NULL,
    origin_source_id TEXT NOT NULL,
    origin_path TEXT NOT NULL,
    path TEXT NOT NULL,
    format TEXT NOT NULL,
    language TEXT,
    forced INTEGER NOT NULL,
    hearing_impaired INTEGER NOT NULL,
    fetched INTEGER NOT NULL,
    PRIMARY KEY (download_id, origin_path)
);

insertDownload:
INSERT OR IGNORE INTO download(id, item_id, origin_version_id, origin_source_id, origin_path, path, state, failure, bytes_downloaded, total_bytes, created_at, updated_at, completed_at)
VALUES (?, ?, ?, ?, ?, ?, ?, NULL, 0, ?, ?, ?, NULL);

allDownloads:
SELECT * FROM download ORDER BY created_at, id;

downloadById:
SELECT * FROM download WHERE id = ?;

downloadOfOrigin:
SELECT * FROM download WHERE origin_version_id = ?;

downloadsOfItem:
SELECT * FROM download WHERE item_id = ? ORDER BY created_at, id;

setDownloadState:
UPDATE download SET state = :state, failure = :failure, updated_at = :now,
    completed_at = CASE WHEN :state = 'COMPLETED' THEN :now ELSE completed_at END
WHERE id = :id;

setDownloadProgress:
UPDATE download SET bytes_downloaded = :bytes, total_bytes = :total, updated_at = :now WHERE id = :id;

setDownloadItem:
UPDATE download SET item_id = ? WHERE id = ?;

deleteDownload:
DELETE FROM download WHERE id = ?;

insertDownloadSubtitle:
INSERT OR REPLACE INTO download_subtitle(download_id, origin_source_id, origin_path, path, format, language, forced, hearing_impaired, fetched)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, 0);

markDownloadSubtitleFetched:
UPDATE download_subtitle SET fetched = 1 WHERE download_id = ? AND origin_path = ?;

subtitlesOfDownload:
SELECT * FROM download_subtitle WHERE download_id = ? ORDER BY origin_path;

deleteSubtitlesOfDownload:
DELETE FROM download_subtitle WHERE download_id = ?;

sourceOfType:
SELECT * FROM source WHERE type = ? ORDER BY added_at, id LIMIT 1;

-- Settings ----------------------------------------------------------------------------------------

-- Reflux's own preferences, by name. Few, and never about media (a choice about a work lives with the work).
CREATE TABLE setting (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

settingValue:
SELECT value FROM setting WHERE key = ?;

setSetting:
INSERT OR REPLACE INTO setting(key, value) VALUES (?, ?);

deleteSetting:
DELETE FROM setting WHERE key = ?;
